# Base path for Vite & GitHub Pages deployment.
# Use "/" for a custom domain (e.g., https://nahrtech.com) or "/<repo-name>/" for GitHub Pages project URLs.
VITE_BASE_PATH="/"

# Public canonical site origin (no trailing slash). Used for canonical URLs, hreflang, OpenGraph, and sitemap.xml.
VITE_SITE_URL="https://nahrtech.com"

# Centralized public contact and integration identifiers (frontend-safe public values only; never store private secrets here).
VITE_CONTACT_EMAIL=""
VITE_WHATSAPP_NUMBER=""
VITE_WEB3FORMS_KEY=""
VITE_GA4_ID=""
VITE_MEDIA_CDN_URL=""
